<Window x:Class="Adoracion.MediaScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Multi window player" Background="Black" Loaded="Window_Loaded" KeyDown="Window_KeyDown"
        WindowStyle="None" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="0">

        <!-- VLC Video View (Main Container) -->
        <!-- We set Opacity to 1.0 by default because it now hosts our entire UI -->
        <vlc:VideoView x:Name="VlcPlayer" Background="Black" Opacity="1.0" Panel.ZIndex="0" Focusable="True" KeyDown="VlcPlayer_KeyDown">
            <Grid x:Name="VideoContainer" Background="Transparent" PreviewMouseMove="Window_PreviewMouseMove">
                <!-- Background Images (inside to bypass Airspace) -->
                <Grid x:Name="ImageContainer" Background="Transparent">
                    <!-- Background layer -->
                    <Rectangle x:Name="ImageBackground" Panel.ZIndex="0" Fill="Black" Opacity="0" />

                    <!-- Foreground Image layer -->
                    <Image x:Name="ImageA" Stretch="Uniform" Opacity="0" Visibility="Collapsed" Panel.ZIndex="1"/>
                    <Image x:Name="ImageB" Stretch="Uniform" Opacity="0" Visibility="Collapsed" Panel.ZIndex="1"/>
                </Grid>

                <!-- Label overlay (inside to bypass Airspace) -->
                <Grid x:Name="LabelOverlay" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="1.0" Panel.ZIndex="2">
                    <TextBlock x:Name="MainText" Text="" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" TextAlignment="Center"/>
                </Grid>

                <!-- Overlay Controls -->
                <Grid x:Name="ControlsOverlay" Visibility="Visible" Opacity="0.05">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                        <Button x:Name="MinimizeButton" Width="30" Height="30" Click="MinimizeButton_Click" Background="#80000000" Foreground="White" BorderThickness="0" Margin="0,0,5,0">
                            <Path Data="{StaticResource MinimizeIcon}" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="CloseButton" Width="30" Height="30" Click="CloseButton_Click" Background="#CCFF0000" Foreground="White" BorderThickness="0">
                            <Path Data="{StaticResource CloseIcon}" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="PlayPauseOverlayButton" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10" Width="50" Height="50" Click="PlayPauseOverlayButton_Click" Background="#80000000" Foreground="White" BorderThickness="0">
                        <Path x:Name="PlayPausePath" Data="{StaticResource PlayArrowIcon}" Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Grid>
        </vlc:VideoView>

        <!-- Legacy MediaElement for fallback (kept outside as it is rarely used) -->
        <MediaElement x:Name="MediaElement" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Manual" Panel.ZIndex="1" />
    </Grid>
</Window>
