<Window x:Class="Adoracion.SaveOpenPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Adoracion.Services"
        Title="{Binding [Title_SavePlaylist], Source={x:Static services:LocalizationService.Instance}}" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" x:Name="SaveOpenPlaylistWindowRoot"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <ControlTemplate x:Key="ComboBoxEditableTemplate" TargetType="{x:Type TextBox}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </ControlTemplate>

        <!-- Modern ComboBox Style to match Search Input -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ItemBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLight}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ItemBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0,35,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderText" 
                                       Text="{Binding [Placeholder_PlaylistName], Source={x:Static services:LocalizationService.Instance}}" 
                                       Foreground="{DynamicResource TextSecondary}"
                                       IsHitTestVisible="False" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""/>
                                    <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ItemBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLight}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ItemBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,10,0"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- ToggleButton handles the click to open/close -->
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <DockPanel Margin="{TemplateBinding Padding}">
                                <Path x:Name="LeadingIcon" 
                                      DockPanel.Dock="Left" 
                                      Data="{TemplateBinding Tag}"
                                      Fill="{DynamicResource TextSecondary}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      IsHitTestVisible="False"/>
                                <Path DockPanel.Dock="Right"
                                      Data="{StaticResource ExpandMoreIcon}"
                                      Fill="{DynamicResource TextSecondary}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="5,0,0,0"
                                      IsHitTestVisible="False"/>
                                <Grid>
                                    <TextBlock x:Name="PlaceholderText" 
                                               Text="{Binding [Placeholder_SelectPlaylist], Source={x:Static services:LocalizationService.Instance}}" 
                                               Foreground="{DynamicResource TextSecondary}" 
                                               IsHitTestVisible="False" 
                                               VerticalAlignment="Center" 
                                               Visibility="Collapsed"/>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      Visibility="Visible"/>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Style="{x:Null}"
                                             Template="{StaticResource ComboBoxEditableTemplate}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Focusable="True"
                                             Background="Transparent"
                                             Visibility="Hidden"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{DynamicResource Primary}"/>
                                </Grid>
                            </DockPanel>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource BackgroundDark}"
                                        BorderBrush="{DynamicResource ItemBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,4">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding Text, ElementName=PART_EditableTextBox}" Value=""/>
                                    <Condition Binding="{Binding IsFocused, ElementName=PART_EditableTextBox}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style from SettingsWindow -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundDark}" CornerRadius="10" BorderBrush="{DynamicResource Primary}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="WindowTitleText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                <Button x:Name="WindowCloseButton" Click="CancelButton_Click" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{DynamicResource PillButtonStyle}" Background="Transparent"
                        Width="32" Height="32" Padding="0">
                    <Path Data="{StaticResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>

            <TextBlock x:Name="InputLabel" Grid.Row="1" 
                       Text="{Binding [Label_PlaylistName], Source={x:Static services:LocalizationService.Instance}}" 
                       Margin="0,0,0,5" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PlaylistNameInput" Grid.Column="0" Grid.ColumnSpan="2"
                         Style="{DynamicResource ModernTextBoxStyle}"
                         TextChanged="PlaylistNameInput_TextChanged"/>
                <Button x:Name="ClearNameButton" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Style="{DynamicResource PlayerControlButton}" Width="28" Height="28"
                        Visibility="{Binding Visibility, ElementName=PlaylistNameInput}"
                        Click="ClearNameButton_Click">
                    <Path Data="{StaticResource CloseIcon}" Width="10" Height="10" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource OnPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <ComboBox x:Name="PlaylistSelector" Grid.Column="0" Height="40" Visibility="Collapsed"
                          IsEditable="True"
                          SelectionChanged="PlaylistSelector_SelectionChanged" Style="{DynamicResource ModernComboBoxStyle}"
                          Tag="{StaticResource MusicNoteIcon}"/>
                <Button x:Name="DeletePlaylistButton" Grid.Column="1" Click="DeletePlaylist_Click" 
                        IsEnabled="False" Width="32" Height="32" Margin="8,0,0,0" 
                        Visibility="Collapsed" ToolTip="{Binding [Tooltip_DeletePlaylist], Source={x:Static services:LocalizationService.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlayerControlButton}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource CloseIcon}" Width="12" Height="12" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource DeleteButtonRed}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
            </Grid>

            <TextBlock x:Name="DuplicateNameErrorLabel" Grid.Row="3" 
                       Text="{Binding [Error_PlaylistAlreadyExists], Source={x:Static services:LocalizationService.Instance}}" 
                       Foreground="{DynamicResource DeleteButtonRed}" 
                       FontSize="11" Margin="0,-15,0,10" 
                       Visibility="Collapsed"
                       HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="4" Text="{Binding [Label_ItemsInPlaylist], Source={x:Static services:LocalizationService.Instance}}" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            <ListBox x:Name="ItemsPreviewList" Grid.Row="5" Margin="0,0,0,20"
                     Background="{DynamicResource ItemBackground}" Foreground="{DynamicResource TextLight}"
                     BorderBrush="{DynamicResource ItemBorder}" BorderThickness="1"
                     HorizontalContentAlignment="Stretch" Panel.ZIndex="-1"
                     ItemContainerStyle="{DynamicResource ListPreviewStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,2" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="295"/>
                                <ColumnDefinition Width="30" MinWidth="20"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" 
                                        ToolTip="{Binding Name}" 
                                        FontSize="12" 
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        MaxWidth="290"/>
                            <Button Grid.Column="1" Click="RemovePreviewItem_Click" ToolTip="{Binding [Tooltip_RemovePlaylistItem], Source={x:Static services:LocalizationService.Instance}}"
                                    Style="{DynamicResource PlayerControlButton}" 
                                    Width="20" Height="20" HorizontalAlignment="Right">
                                <Path Data="{StaticResource CloseIcon}" Fill="{DynamicResource DeleteButtonRed}" 
                                      Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{Binding [Button_Cancel], Source={x:Static services:LocalizationService.Instance}}" Click="CancelButton_Click" 
                        Width="100" Height="35" Margin="0,0,10,0"
                        Style="{DynamicResource PillButtonStyle}" Background="Transparent"
                        IsCancel="True"/>
                <Button x:Name="SaveButton" IsEnabled="False" Click="SaveButton_Click"
                        Width="100" Height="35"
                        Style="{DynamicResource ModernButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>