<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>adoracion-icon.ico</ApplicationIcon>
    <Company>Matias Orosco</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<!-- Version settings -->
	  <AssemblyVersion>0.9.0.4</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="SecondaryControlWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="adoracion-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Hymns\" />
    <Folder Include="resources\" />
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="resources\Languages.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Update="Models\MediaFile.cs" />
    <Compile Update="Models\ScreenInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.6" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="SQLite" Version="3.13.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows.GPL" Version="3.0.23" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Hymns\add_media_here.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="resources\default_background.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure all custom theme XAML files are copied to the output directory -->
    <Content Include="Themes\Color_Themes\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="UserSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="UserSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
</Project>
