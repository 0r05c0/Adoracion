<Window x:Class="Adoracion.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="Auto" Width="400" 
        SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <!-- Reusing the style from SaveOpenPlaylistWindow for consistency -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource BackgroundDark}" 
            CornerRadius="12" 
            BorderBrush="{DynamicResource Primary}" 
            BorderThickness="1" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Path x:Name="IconPath" Data="{StaticResource InfoIcon}" 
                      Fill="{DynamicResource Primary}" 
                      Width="20" Height="20" Stretch="Uniform" 
                      Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TxtMessage" Grid.Row="1" 
                       FontSize="14" Foreground="{DynamicResource TextLight}" 
                       TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnNo" Content="No" Click="BtnNo_Click"
                        Width="90" Height="35" Margin="0,0,10,0"
                        Style="{DynamicResource PillButtonStyle}"
                        Visibility="Collapsed"/>
                
                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                        Width="90" Height="35" Margin="0,0,10,0"
                        Style="{DynamicResource PillButtonStyle}"
                        Visibility="Collapsed"/>

                <Button x:Name="BtnOk" Content="OK" Click="BtnOk_Click"
                        Width="90" Height="35"
                        Style="{StaticResource ModernButtonStyle}"/>
                
                <Button x:Name="BtnYes" Content="Yes" Click="BtnYes_Click"
                        Width="90" Height="35"
                        Style="{StaticResource ModernButtonStyle}"
                        Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>